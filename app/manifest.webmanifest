{
  "name": "CitySteps Reader",
  "short_name": "Reader",
  "description": "Read PDFs aloud and catch the ideas they spark.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "lang": "en-CA",
  "background_color": "#FEFDF8",
  "theme_color": "#FEFDF8",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "pdf", "accept": ["application/pdf", ".pdf", "audio/*", ".m4a", ".mp3", ".wav", ".ogg", ".opus", ".webm", ".aac", "text/markdown", ".md", "text/plain"] }]
    }
  }
}
